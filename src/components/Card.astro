---
import { Image } from 'astro:assets';

interface Props {
  id: string;
  href: string;
  primary_color: string;
  secondary_color: string;
  background: string;
  bustPortrait: string;
  agentName: string;
}

const { id, href, primary_color, secondary_color, background, bustPortrait, agentName } = Astro.props;
---

<a href={href} id={id} class={`aspect-[3/4] flex flex-col overflow-hidden container group`} style={`background-image: radial-gradient(circle, #${primary_color}, #${secondary_color})`} data-astro-prefetch data-aos="fade-up" >
  <div class="relative w-full h-full">
    <Image
      src={background}
      alt={`background-${agentName}`}
      width="200"
      height="150"
      format='webp'
      class="absolute inset-0 w-full h-full object-cover p-4"
    />
    <Image
      id={`bustPortrait-${id}`}
      src={bustPortrait}
      alt={`bust-portrait-${agentName}`}
      width="200"
      height="150"
      format='webp'
      class="absolute inset-0 w-full h-full object-cover transition-transform group-hover:scale-110 duration-300"
      transition:name={`bustPortrait-${agentName}`}
    />
  </div>
  <div class="w-full h-auto">
    <p id={`displayName-${id}`} class="font-extrabold uppercase leading-6 py-2 px-4 bg-white group-hover:bg-transparent transition-colors duration-300 group-hover:text-white">
      {agentName}
    </p>
  </div>
</a>

<style>
  p {
    font-family: "Oswald Variable", sans-serif;
  }
</style>
