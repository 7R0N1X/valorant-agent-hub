---
import { ClientRouter } from 'astro:transitions';
import "@fontsource-variable/oswald";
import "@fontsource-variable/inter";
import Navbar from "../sections/Navbar.astro";
import Footer from "../sections/Footer.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Descubre a fondo a los agentes de Valorant con nuestra completa guía. Explora habilidades, estrategias y perfiles detallados de cada agente en este compendio especializado. ¡Todo lo que necesitas para dominar Valorant en un solo lugar!" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class="bg-[#0f1923]">
		<Navbar />
		<main class="max-w-[1436px] mx-auto p-4">
			<slot />
		</main>
		<Footer />
		<script src="../config/aosAnimateConfig.js"></script>
	</body>
</html>

<style is:global>
	::-webkit-scrollbar {
		width: 4px;
	}

	::-webkit-scrollbar-thumb {
		background: gray;
		border-radius: 8px;
	}

	::-webkit-scrollbar-track {
		background: #0A1017;
	}
</style>
