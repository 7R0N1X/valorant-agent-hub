---
import MenuIcon from "src/assets/MenuIcon.astro";

const NAV_ITEMS = [
  { url: "/", role: "Todos", title: "Ver todos los agentes" },
  { icon: "/roles/duelist.svg", url: "/agent/duelist", role: "Dualista", title:"Ver agentes duelistas" },
  { icon: "/roles/controller.svg", url: "/agent/controller", role: "Controlador", title:"Ver agentes controladores" },
  { icon: "/roles/initiator.svg", url: "/agent/initiator", role: "Iniciador", title:"Ver agentes iniciadores" },
  { icon: "/roles/sentinel.svg", url: "/agent/sentinel", role: "Centinela", title:"Ver agentes centinelas" },
];
---

<header class="w-full bg-[#0A1017] border-b border-gray-800 navbar" transition:name="navbar">
  <section class="w-full max-w-[1436px] mx-auto flex items-center justify-between p-4">
    <a href="/" title="Ir al inicio">
      <img src="/logos/valorant.svg" alt="Logo de Valorant" class="w-full h-5 lg:h-6"/>
    </a>

    <button class="menu lg:hidden" aria-label="menu">
      <MenuIcon class="size-6 text-white" />
    </button>

    <nav class="hidden lg:block">
      <ul class="flex items-center gap-2">
        {
          NAV_ITEMS.map((navItem) => (
            <li>
              <a href={navItem.url} class="text-gray-400 hover:text-white transition-all duration-300 flex items-center gap-2 py-2 px-4 rounded-lg navbar__link" title={navItem.title}>
                {navItem.icon && <img src={navItem.icon} alt={`Icono del rol ${navItem.role.toLowerCase()}`} class="size-4" />}
                {navItem.role.toUpperCase()}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>
  
  <nav class="px-4 pb-4 hidden mobile__menu">
    <ul class="flex flex-col items-center gap-2">
      {
        NAV_ITEMS.map((navItem) => (
          <li class="w-full">
            <a href={navItem.url} class="text-gray-400 hover:text-white transition-all duration-300 flex items-center gap-2 py-2 px-4 rounded-lg navbar__link" title={navItem.title}>
              {navItem.icon && <img src={navItem.icon} alt={`Icono del rol ${navItem.role.toLowerCase()}`} class="size-4" />}
              {navItem.title.toUpperCase()}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .active {
    color: #fff;
    background-color: #FA4453;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const navLinks = document.querySelectorAll(".navbar__link");
    const currentPath = window.location.pathname;
    
    navLinks.forEach((navLink) => {
      navLink.getAttribute("href") === currentPath &&
        navLink.classList.toggle("active");
    });

    const menuBtn = document.querySelector('.menu')
    const mobileMenu = document.querySelector('.mobile__menu')
    
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden')
    })
  });
</script>
