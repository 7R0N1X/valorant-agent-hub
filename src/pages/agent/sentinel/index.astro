---
import Layout from "@layouts/Layout.astro";
import AgentsLayout from "@layouts/AgentsLayout.astro";
import { getAgents } from "@services/agents";

const agents = await getAgents();
const sentinel = agents.filter(agent => agent.role.displayName.toString() === "Centinela")
---

<Layout title="Centinelas">
  <AgentsLayout titleSection="Centinelas" agents={sentinel} />
</Layout>
